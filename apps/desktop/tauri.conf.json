{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS-Q Vault",
  "version": "0.1.0",
  "identifier": "org.nexusq.vault",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "NEXUS-Q Vault", "width": 1080, "height": 760, "minWidth": 760, "minHeight": 620, "resizable": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "targets": "all", "icon": ["icons/icon.png"] }
}
